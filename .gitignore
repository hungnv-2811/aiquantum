*.parquet
*.zip
*.rar
*.tar.gz

# BCTC/BCTN tải về
*.pdf
!docs/**/*.pdf

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
