# ── Dữ liệu (không commit — tải lại bằng script trong smartaudit/ingest) ──
/data/
!/data/.gitkeep
*.parquet
*.zip
*.rar
*.tar.gz

# BCTC/BCTN tải về
*.pdf
!docs/**/*.pdf

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# ── Model & kết quả huấn luyện ──
models/
checkpoints/
*.pt
*.pth
*.safetensors
wandb/
mlruns/

# ── Node ──
node_modules/

# ── Hệ điều hành / IDE ──
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# ── Tạm ──
tmp/
*.log
*.tmp
~$*.docx
~$*.xlsx

# Môi trường riêng cho lớp lượng tử (qiskit) — tách khỏi .venv chính
.venv-quantum/

# Thông tin cá nhân thành viên (CCCD, SĐT) — chỉ dùng để điền báo cáo nộp BTC
*.local.json

# Bộ nộp Vòng 2 — báo cáo .docx có bảng CCCD thành viên; mẫu Word và ảnh xem trước là tệp sinh/nhị phân lớn
deliverables/*.docx
deliverables/build/*.docx
deliverables/build/slide_png/
deliverables/build/huong_dan.filled.html
results/run_nnc_log.txt

# Hồ sơ dự thi có CCCD/SĐT thành viên — giữ trên máy, không đưa vào git
SmartAudit_Quantum_Proposal*.docx

# Bản sao lưu bộ nộp trước khi bổ sung dữ liệu
deliverables/_ban_*/

# Chữ ký tay và ảnh cá nhân: chỉ giữ trên máy, không commit, không vào gói nộp
*.local.png
*.local.jpg
