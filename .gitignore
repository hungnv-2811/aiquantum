# ── Model & kết quả huấn luyện ──
models/
checkpoints/
*.pt
*.pth
*.safetensors
wandb/
mlruns/

# ── Node ──
node_modules/

# ── Hệ điều hành / IDE ──
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# ── Tạm ──
tmp/
*.log
*.tmp
~$*.docx
~$*.xlsx
